# Copy to docker-compose.env and fill in. docker-compose.env is gitignored.
# Only used by the old Moleculer docker-compose setup; the active server (server.js) reads .env.
NAMESPACE=
LOGGER=true
LOGLEVEL=info
SERVICEDIR=services

TRANSPORTER=nats://nats:4222

# Database Configuration
POSTGRES_URI=postgresql://USER:PASSWORD@localhost:5432/frruit_db

# JWT Configuration
JWT_SECRET=

# Python AI API Configuration
PYTHON_AI_API_KEY=

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# Email Configuration (for utility.js)
senderEmailHost=
senderEmailPort=465
senderEmailservice=
senderEmailPass=
senderEmail=
