# ─── Core ─────────────────────────────────────────────────────────────────────
PORT=4000
POSTGRES_URI=postgres://USER:PASSWORD@127.0.0.1:5435/frruit_db   # needs the pgvector image (pgvector/pgvector:pg16)
JWT_SECRET=
# Public URL of this API, used in upload and document links (default: derived from the request host)
PUBLIC_API_URL=

# ─── Email OTP login ──────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_SENDER=

# ─── OpenAI (chat, embeddings, verification, translation, voice) ──────────────
OPENAI_API_KEY=
# OPENAI_BASE_URL=http://127.0.0.1:4010/v1      # only for the offline mock (test/mock-openai.js)
CHAT_MODEL=gpt-5-search-api          # main chat, with web search
DOCS_CHAT_MODEL=gpt-4.1-mini         # document Q&A (answers only from the uploaded document)
RAG_AI_MODEL=gpt-4.1-mini            # follow-up question rewriting
VERIFY_MODEL=gpt-4.1-mini            # evidence check of every answer
EMBED_MODEL=text-embedding-3-small   # must produce 1536-dim vectors (text-embedding-3-small / -large)
LANG_AI_MODEL=gpt-4.1-mini           # language detection + translation
NEWS_AI_MODEL=gpt-4.1-mini           # news sentiment + ticker tagging
MARKET_AI_MODEL=gpt-4.1-mini         # hourly market summary
VOICE_MODEL=gpt-4o-mini-transcribe   # voice input fallback (browsers without Web Speech API)

# ─── RAG + evidence safeguard ─────────────────────────────────────────────────
CONFIDENCE_THRESHOLD=0.6     # answers below this are marked UNCERTAIN
RAG_MIN_SIMILARITY=0.3       # cosine similarity floor for retrieved chunks
RAG_TOP_K=6                  # chunks given to the main chat
RAG_DOCS_TOP_K=8             # chunks given to document Q&A
RAG_CHUNK_CHARS=3200         # ≈ 800 tokens per chunk
RAG_OVERLAP_CHARS=480        # ≈ 120 tokens overlap
UPLOAD_DIR=                  # default: frruit-be/storage/documents
UPLOAD_MAX_MB=20

# ─── Human review ─────────────────────────────────────────────────────────────
# Comma-separated emails that get the reviewer role (Review queue at /review)
REVIEWER_EMAILS=

# ─── Market data ──────────────────────────────────────────────────────────────
# Optional: Finnhub API key adds Finnhub market news to the feed (free tier at finnhub.io)
FINNHUB_API_KEY=
